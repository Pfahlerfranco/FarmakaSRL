# Copiá este archivo como `.env.local` y completá los valores.

# Endpoint de Formspree que recibe el formulario de contacto.
# Se saca del panel de Formspree, en la pestaña "Integration" del formulario.
# Formato: https://formspree.io/f/<ID>
#
# Si queda vacío, el formulario simula el envío y loguea el payload en consola.
VITE_CONTACT_ENDPOINT=
